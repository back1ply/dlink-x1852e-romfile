# Template for secrets.local.env — copy it and fill in the real values.
# secrets.local.env is gitignored; nothing here is.
#
# Precedence in the tools: command-line flag > environment variable > secrets.local.env.

# Web UI login (acl_toggle.py). The account is the one in Account/Entry0 of the
# romfile (username=, web_passwd=).
X1852E_HOST=192.168.1.1
X1852E_WEB_USER=root
X1852E_WEB_PASS=change-me

# Telnet login (telnet_exec.py). Use the account whose shell is uid 0 — on this
# unit that is `root`; the `admin` account is a normal user and cannot read
# /dev/mtd0.
X1852E_TELNET_USER=root
X1852E_TELNET_PASS=change-me
